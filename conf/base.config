// Containers and resources per process. Limits come from run.sh (MAX_CPUS, MAX_MEMORY).
def ANALYSIS = 'ghcr.io/manuelgug/16s-function-inference-analysis:0.1.0'

process {
    resourceLimits = [cpus: params.max_cpus as int, memory: params.max_memory as MemoryUnit]
    container      = ANALYSIS
    errorStrategy  = { task.exitStatus in [137, 140, 143] || task.attempt == 1 ? 'retry' : 'terminate' }
    maxRetries     = 2
    cpus           = 1
    memory         = 4.GB

    withName: 'FETCH_GENOMES'    { cpus = 1;  memory = 2.GB;  maxForks = 2 }   // polite to NCBI: 2 tasks x 4 connections
    withName: 'BARRNAP'          { cpus = 8;  memory = 8.GB;  container = 'quay.io/biocontainers/barrnap:0.9--hdfd78af_4' }
    withName: 'PROCESS_GENOMES'  { cpus = 8;  memory = 16.GB }
    withName: 'EGGNOG'           { cpus = { params.max_cpus as int }; memory = 48.GB; maxForks = 1
                                   container = 'quay.io/biocontainers/eggnog-mapper:2.1.15--pyhdfd78af_0' }
    withName: 'SINA_INDEX'       { cpus = 4;  memory = 16.GB; container = 'quay.io/biocontainers/sina:1.7.2--h9aa86b4_0' }
    withName: 'ALIGN_16S'        { cpus = { params.max_cpus as int }; memory = 32.GB
                                   container = 'quay.io/biocontainers/sina:1.7.2--h9aa86b4_0' }
    withName: 'SELECT_GENOMES|BUILD_TARGETS|BUILD_FEATURES|QC_REPORT' { cpus = 2; memory = 32.GB }
}
