// Containers and resources per process. Limits come from run.sh (MAX_CPUS, MAX_MEMORY).
process {
    resourceLimits = [cpus: params.max_cpus as int, memory: params.max_memory as MemoryUnit]
    container      = 'ghcr.io/manuelgug/16s-function-inference-analysis:0.3.0'  // tag = containers/analysis/VERSION
    errorStrategy  = { task.exitStatus in [137, 140, 143] || task.attempt == 1 ? 'retry' : 'terminate' }
    maxRetries     = 2
    cpus           = 1
    memory         = 4.GB

    // Per-genome steps keep their own image tag: a new analysis image (e.g. a report library) must not
    // invalidate their cache, which would re-download every genome and re-run eggNOG (D072). Same tools as 0.3.0.
    withName: 'FETCH_GENOMES|PROCESS_GENOMES' { container = 'ghcr.io/manuelgug/16s-function-inference-analysis:0.1.0' }
    withName: 'FETCH_GENOMES'    { cpus = 1;  memory = 2.GB;  maxForks = 2 }   // polite to NCBI: 2 tasks x 4 connections
    withName: 'BARRNAP'          { cpus = 8;  memory = 8.GB;  container = 'quay.io/biocontainers/barrnap:0.9--hdfd78af_4' }
    withName: 'PROCESS_GENOMES'  { cpus = 8;  memory = 16.GB }
    withName: 'EGGNOG'           { cpus = { params.max_cpus as int }; memory = 48.GB; maxForks = 1
                                   container = 'quay.io/biocontainers/eggnog-mapper:2.1.15--pyhdfd78af_0' }
    withName: 'SINA_INDEX'       { cpus = 4;  memory = 16.GB; container = 'quay.io/biocontainers/sina:1.7.2--h9aa86b4_0' }
    // deep (content) caching: these take collectFile outputs, whose mtime changes on every run
    withName: 'ALIGN_16S|BUILD_FEATURES|QC_REPORT' { cache = 'deep' }
    withName: 'ALIGN_16S'        { cpus = { params.max_cpus as int }; memory = 32.GB
                                   container = 'quay.io/biocontainers/sina:1.7.2--h9aa86b4_0' }
    withName: 'SELECT_GENOMES|BUILD_FEATURES|QC_REPORT|AIM2_PREP|AIM2_REPORT' { cpus = 2; memory = 32.GB }
    withName: 'BUILD_TARGETS'    { cpus = 2;  memory = 32.GB }  // module completeness vectorised (D079)
    withName: 'AIM2_PYSEER'      { cpus = 1;  memory = 8.GB; container = 'quay.io/biocontainers/pyseer:1.4.2--pyhdfd78af_0' }

    // benchmark (benchmark.nf)
    withName: 'PSC_EXPORT|PICRUST2_FOLD' { container = 'quay.io/biocontainers/picrust2:2.6.4--pyhdfd78af_0' }
    withName: 'BENCH_EXTRACT|BENCH_SPLITS|BENCH_PREPARE|BENCH_P2_REF|BENCH_P2_PRED|BENCH_MERGE' { cpus = 1; memory = 16.GB }
    // EPA-ng placement peaks at ~137 GB against 22k references (D094); bench_test references are tiny
    withName: 'PICRUST2_FOLD'    { cpus = 8;  memory = { (params.bench_subsample as int) > 0 ? 8.GB : 120.GB } }
    withName: 'BENCH_PREDICT|BENCH_PREDICT_STACKED' { cpus = 8; memory = 12.GB }
    withName: 'BENCH_MLP'        { cpus = 8;  memory = 12.GB }
    withName: 'BENCH_STACKER'    { cpus = 16; memory = 48.GB }
    withName: 'BENCH_EVAL'       { cpus = 16; memory = 96.GB }
    withName: 'BENCH_COMMUNITY'  { cpus = 4;  memory = 32.GB }
}
