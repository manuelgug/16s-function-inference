// Parameter VALUES live in run.sh (USER PARAMETERS block), which writes them to <outdir>/params.json.
// Here they are only declared; main.nf refuses to start if any is missing.
params {
    gtdb_release      = null
    silva_release     = null
    min_completeness  = null
    max_contamination = null
    min_ssu_len       = null
    full_n            = null
    seed              = null
    min_per_phylum    = null
    min_col_coverage  = null
    min_allele_freq   = null
    primers           = null
    pcr_error_rate    = null
    ko_min_prevalence = null
    ko_max_prevalence = null
    holdout_levels    = null
    cv_folds          = null
    batch_size        = null
    max_cpus          = null
    max_memory        = null
    db_dir            = null
    outdir            = null
    genome_list       = null   // set by the test/pilot profiles; full scale selects from GTDB
    trace_suffix      = new java.util.Date().format('yyyyMMdd-HHmmss')
}

manifest {
    name            = 'manuelgug/16s-function-inference'
    homePage        = 'https://github.com/manuelgug/16s-function-inference'
    description     = 'Inferring prokaryotic functional profiles from 16S rRNA mutation profiles'
    mainScript      = 'main.nf'
    nextflowVersion = '>=26.10.0'
    version         = '0.1.0'
}

includeConfig 'conf/base.config'

profiles {
    test      { params.genome_list = "${projectDir}/config/test_genomes.tsv" }
    pilot     { params.genome_list = "${projectDir}/config/pilot_genomes.tsv" }
    full      { params.genome_list = null }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = "${projectDir}/.apptainer"
    }
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${params.trace_suffix}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${params.trace_suffix}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${params.trace_suffix}.tsv"
           fields  = 'task_id,hash,name,status,exit,duration,realtime,cpus,%cpu,peak_rss,rchar,wchar' }
